FRIDAY_IMAGE_TAG=2026.08.10
FRIDAY_GATEWAY_PORT=18789
FRIDAY_HOME_VOLUME=friday_home
FRIDAY_INSTANCE_CONFIG=./config/instance.container.json
FRIDAY_REPOSITORIES_DIR=/absolute/path/to/read-only-repositories
FRIDAY_JIRA_EMAIL=owner@example.com
# Put the Jira API token in container/secrets/jira-api-token. The configured
# jira.apiTokenEnv name is exported only inside Friday containers.
