{
  "name": "@friday/openai-docs-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixed-endpoint OpenAI model documentation reader for Friday.",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run build && node --check dist/index.js"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "@friday/shared": "0.3.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/index.js",
    "dist/local-error-log.js",
    "openclaw.plugin.json"
  ]
}
