{
  "id": "friday-security-shield",
  "name": "Friday Security Shield",
  "description": "Owner-only exact Slack account/workspace/channel/user tuple authorization, persona shielding, untrusted-input guidance, and minimal audit.",
  "version": "1.2.3",
  "activation": { "onStartup": true },
  "contracts": { "tools": [] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["principalEmail", "allowedSlackBindings"],
    "properties": {
      "principalEmail": { "type": "string" },
      "allowedSlackBindings": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "workspaceId", "channelId", "userId"],
          "properties": {
            "accountId": { "type": "string" },
            "workspaceId": { "type": "string" },
            "channelId": { "type": "string" },
            "userId": { "type": "string" }
          }
        }
      },
      "allowedSlackUserIds": { "type": "array", "items": { "type": "string" } },
      "allowedSlackChannelIds": { "type": "array", "items": { "type": "string" } },
      "allowedSlackAccountIds": { "type": "array", "items": { "type": "string" } },
      "silentDeny": { "type": "boolean" },
      "auditRetentionDays": { "type": "number", "minimum": 1, "maximum": 90 }
    }
  }
}
